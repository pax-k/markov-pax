{
  "name": "markov-pax",
  "version": "0.1.0",
  "description": "Finite-state Markov models, inference, decisions, workflows, and trace analysis for TypeScript.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "author": "Pax",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "test:coverage": "bun test --coverage",
    "build:js": "bun build ./index.ts --outdir ./dist --format esm --target browser",
    "build:types": "bunx tsc -p tsconfig.build.json && bun ./scripts/rewrite-declaration-imports.ts",
    "build": "bun run build:js && bun run build:types",
    "test:package": "bun ./scripts/test-package.ts",
    "check:docs": "bun ./scripts/check-docs.ts",
    "check:source": "bun run typecheck && bun run test:coverage && bun run check:docs",
    "benchmark": "bun ./scripts/benchmark.ts",
    "check": "bun run check:source && bun run build && bun run test:package"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
